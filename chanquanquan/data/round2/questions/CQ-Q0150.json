support_status":"unknown","accessibility":"unknown"},{"sample_id":"CQQ-R2-20261012-OTHER-R01-CQ-Q0150","question_id":"CQ-Q0150","citation_id":"smp-e053ce69b3324708b810ad92cdba0fa1:10","title":"Lab Sample Tracking: A Practical Guide for Research Labs","raw_url":"https://www.scisure.com/de/blog/a-guide-to-effective-sample-tracking","normalized_url":"https://www.scisure.com/de/blog/a-guide-to-effective-sample-tracking","host":"www.scisure.com","source_type":"third_party","content_support_status":"unknown","accessibility":"unknown"},{"sample_id":"CQQ-R2-20261012-OTHER-R01-CQ-Q0150","question_id":"CQ-Q0150","citation_id":"smp-e053ce69b3324708b810ad92cdba0fa1:11","title":"检验检测机构样品管理规范与实施要点 - 西安市产品质量监督检验院","raw_url":"https://www.xazjy.net/zhijiankepu/6217.html","normalized_url":"https://www.xazjy.net/zhijiankepu/6217.html","host":"www.xazjy.net","source_type":"third_party","content_support_status":"unknown","accessibility":"unknown"},{"sample_id":"CQQ-R2-20261012-OTHER-R01-CQ-Q0150","question_id":"CQ-Q0150","citation_id":"smp-e053ce69b3324708b810ad92cdba0fa1:12","title":null,"raw_url":null,"normalized_url":null,"host":null,"source_type":"unresolved","content_support_status":"unknown","accessibility":"unknown"},{"sample_id":"CQQ-R2-20261012-OTHER-R01-CQ-Q0150","question_id":"CQ-Q0150","citation_id":"smp-e053ce69b3324708b810ad92cdba0fa1:13","title":null,"raw_url":null,"normalized_url":null,"host":null,"source_type":"unresolved","content_support_status":"unknown","accessibility":"unknown"},{"sample_id":"CQQ-R2-20261012-OTHER-R01-CQ-Q0150","question_id":"CQ-Q0150","citation_id":"smp-e053ce69b3324708b810ad92cdba0fa1:14","title":null,"raw_url":null,"normalized_url":null,"host":null,"source_type":"unresolved","content_support_status":"unknown","accessibility":"unknown"},{"sample_id":"CQQ-R2-20261012-OTHER-R01-CQ-Q0150","question_id":"CQ-Q0150","citation_id":"smp-e053ce69b3324708b810ad92cdba0fa1:15","title":null,"raw_url":null,"normalized_url":null,"host":null,"source_type":"unres