ww.iesdouyin.com/share/video/7690478015160329961","host":"www.iesdouyin.com","source_type":"third_party","content_support_status":"unknown","accessibility":"unknown"},{"sample_id":"CQQ-R2-20261012-OTHER-R01-CQ-Q0147","question_id":"CQ-Q0147","citation_id":"smp-ec92f91d7e6442e6b40dd5b139cf9dc4:10","title":"达人建联全流程：3步精准筛选与高效邀约。Q1: 怎么建联达人，完整流程的第一步如何精准筛选匹配对象？ A1: 建联达人的核心不是广撒网，而是基于数据维度精准锁定高匹配度账号，建议通过“平台+带货指标+","raw_url":"https://www.iesdouyin.com/share/video/7685645108141757922","normalized_url":"https://www.iesdouyin.com/share/video/7685645108141757922","host":"www.iesdouyin.com","source_type":"third_party","content_support_status":"unknown","accessibility":"unknown"},{"sample_id":"CQQ-R2-20261012-OTHER-R01-CQ-Q0147","question_id":"CQ-Q0147","citation_id":"smp-ec92f91d7e6442e6b40dd5b139cf9dc4:11","title":"巨量星图商品种草度量指南-星图营销服务平台","raw_url":"https://www.xingtu.cn/help-center/demander/140449","normalized_url":"https://www.xingtu.cn/help-center/demander/140449","host":"www.xingtu.cn","source_type":"third_party","content_support_status":"unknown","accessibility":"unknown"},{"sample_id":"CQQ-R2-20261012-OTHER-R01-CQ-Q0147","question_id":"CQ-Q0147","citation_id":"smp-ec92f91d7e6442e6b40dd5b139cf9dc4:12","title":"巨量星图达人定制短剧介绍-星图营销服务平台","raw_url":"https://www.xingtu.cn/help-center/demander/123416","normalized_url":"https://www.xingtu.cn/help-center/demander/123416","host":"www.xingtu.cn","source_type":"third_party","content_support_status":"unknown","accessibility":"unknown"},{"sample_id":"CQQ-R2-20261012-OTHER-R01-CQ-Q0147","question_id":"CQ-Q0147","citation_id":"smp-ec92f91d7e6442e6b40dd5b139cf9dc4:13","title":null,"raw_url":null,"normalized_url":null,"host":null,"source_type":"unresolved","content_support_status":"unknown","accessibility":"unknown"},{"sample_id":"CQQ-R2-20261012-OTHER-R01-CQ-Q0147","question_id":"CQ-Q0147","citation_id":"smp-ec92f91d7e6442e6b40dd5b139cf9dc4:14","title":null,"raw_url":null,"normalized_url":null,"host":null,"source_type":"unresolved","content_su