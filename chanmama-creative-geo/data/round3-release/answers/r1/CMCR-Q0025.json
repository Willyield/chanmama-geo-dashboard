m/school/infos66218.html","normalizedUrl":"https://wap.shuaishou.com/school/infos66218.html","domain":"wap.shuaishou.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"新建全域投放计划-千川PC乘方& 全域投放-商业开放平台","url":"https://open.oceanengine.com/labels/12/docs/1804360384937988","normalizedUrl":"https://open.oceanengine.com/labels/12/docs/1804360384937988","domain":"open.oceanengine.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"抖音","url":"https://iesdouyin.com/share/video/7620779939599630330","normalizedUrl":"https://iesdouyin.com/share/video/7620779939599630330","domain":"iesdouyin.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"投放流程介绍说明-千川PC标准投放-商业开放平台","url":"https://open.oceanengine.com/docs/1698797636713486","normalizedUrl":"https://open.oceanengine.com/docs/1698797636713486","domain":"open.oceanengine.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"搜狐","url":"https://m.sohu.com/a/1004529290_121886043","normalizedUrl":"https://m.sohu.com/a/1004529290_121886043","domain":"m.sohu.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"抖音","url":"https://iesdouyin.com/share/video/7544311342484819240","normalizedUrl":"https://iesdouyin.com/share/video/7544311342484819240","domain":"iesdouyin.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"如何查看对方千川素材? - 自媒体问答 - HCRM问答","url":"https://bbs.huochengrm.cn/questions/20946.html","normalizedUrl":"https://bbs.huochengrm.cn/questions/20946.html","domain":"bbs.huochengrm.cn","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"获取千川素材库视频-素材管理-商业开放平台","url":"https://open.oceanengine.com/labels/12/docs/1739309912219663","normalizedUrl":"https://open.oceanengine.com/labels/12/docs/1739309912219663","domain":"open.oceanengine.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"CSDN博客","url":"https://blog.csdn.net/you24233/article/details/122362169","normalizedUrl":"https://blog.csdn.net/you24233/article/details/122362169","domain":"blog.csdn.net","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"抖音","url":"https://iesdouyin.com/share/video/7666439453400894783","normalizedUrl":"https://iesdouyin.com/share/video/7666439453400894783","domain":"iesdouyin.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"今日头条","url":"http://m.toutiao.com/group/7619240054103261736","normalizedUrl":"http://m.toutiao.com/group/7619240054103261736","domain":"m.toutiao.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"一文掌握「低效素材」和「低质素材」优化方法!不及时处理会影响跑量 – 买量小飞机","url":"http://smallfighter.com/post/3366","normalizedUrl":"http://smallfighter.com/post/3366","domain":"smallfighter.com","validUrl":true,"contentStatus":"页面内容未核验"}]},{"id":"CMCR-S-20260819-C1-Q0025","q":"CMCR-Q0025","question":"千川隐藏素材在哪里看？","day":2,"repeat":1,"valid":true,"answer":"“千川隐藏素材”通常分为**自己账号内被隐藏的素材**和**竞品未公开的投放素材**两种情况，查看方式不同，具体如下：\n\n### 一、查看自己账号内的隐藏素材（巨量千川PC端）\n如果是你自己上传后被设置为“隐藏”、或在常规列表中看不到的素材，可按以下路径查找：\n1. **基础入口：素材管理筛选**\n   登录巨量千川PC后台 → 左侧菜单点击「工具」→「创意管理」→「视频库/素材库」→ 在素材列表的筛选栏中，选择「状态」筛选，查看是否有“已隐藏”分类，勾选后即可展示隐藏素材；部分版本可通过「素材建议」或「更多筛选」找到隐藏素材入口。\n2. **素材分析页面查询**\n   进入「数据」→「素材分析」→「视频素材」，通过筛选条件（如素材状态、上传时间、素材来源）排查，即使素材被隐藏，历史投放过的素材数据仍会在素材分析中保留记录。\n3. **创编计划时找回**\n   新建/编辑计划时，点击「添加视频」→「我的视频」，在素材库的筛选中选择“全部状态”，即可看到包含隐藏在内的所有素材，支持取消隐藏后重新使用。\n\n### 二、查看竞品的隐藏千川素材（第三方工具）\n竞品直接通过千川后台投放、未公开在抖音主页的“隐藏素材”，无法在千川官方后台查看，需借助第三方数据工具挖掘：\n以**蝉妈妈**为例（2026年仍在更新支持）：\n1. 进入蝉妈妈后台 → 选择「创意」模块 → 点击「找素材」；\n2. 使用「素材定向追踪」功能，输入竞品的抖音号、小店名称或品牌关键词，系统可在30分钟内捕获同行新投的隐藏素材（含直播引流、商品广告、CID广告等类型）；\n3. 可通过“品类、素材形式、完播率、跑量条件”等维度筛选，重点查看「跑量素材榜」「高增量素材榜」，快速定位竞品高转化隐藏素材，支持查看脚本、分镜、口播文案等细节。\n类似工具还有巨量创意的「创意洞察」（仅支持参考公开优质素材，无法直接看竞品隐藏素材）、飞瓜数据等。\n\n### 补充说明\n- 千川平台版本会不定期更新，若上述入口位置有变化，可在后台右上角搜索“隐藏素材”，或联系千川官方客服获取最新操作路径；\n- 查看竞品素材时，建议仅用作创意参考，不要直接搬运侵权素材。","answerHash":"90b1b02fa77b1bad59f62f35d1696acc8418fe2bf9010edce1e702874d20e227","finishedAt":"2026-08-19","replacement":false,"brands":["蝉妈妈"],"sources":[{"title":"如何查看千川素材？","url":"https://bbs.huochengrm.cn/questions/4320.html","normalizedUrl":"https://bbs.huochengrm.cn/questions/4320.html","domain":"bbs.huochengrm.cn","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"如何查看千川素材？","url":"https://bbs.huochengrm.cn/questions/4320.html","normalizedUrl":"https://bbs.huochengrm.cn/questions/4320.html","domain":"bbs.huochengrm.cn","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"竞品千川素材怎么查？蝉妈妈监控投放策略 原创","url":"https://blog.csdn.net/chanmama8888/article/details/163539515","normalizedUrl":"https://blog.csdn.net/chanmama8888/article/details/163539515","domain":"blog.csdn.net","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"【巨量千川】短视频带货场景优质素材产品功能使用指南","url":"https://cc.oceanengine.com/academy/article-detail/10338","normalizedUrl":"https://cc.oceanengine.com/academy/article-detail/10338","domain":"cc.oceanengine.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"竞品千川素材怎么查？蝉妈妈监控投放策略 原创","url":"https://blog.csdn.net/chanmama8888/article/details/163539515","normalizedUrl":"https://blog.csdn.net/chanmama8888/article/details/163539515","domain":"blog.csdn.net","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"如何查看千川素材？","url":"https://bbs.huochengrm.cn/questions/4320.html","normalizedUrl":"https://bbs.huochengrm.cn/questions/4320.html","domain":"bbs.huochengrm.cn","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"抖音千川投流避坑指南，高效推广短视频的秘诀","url":"https://www.jiajutu.com/jiaocheng/046047.html","normalizedUrl":"https://www.jiajutu.com/jiaocheng/046047.html","domain":"www.jiajutu.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"如何查看千川素材？","url":"https://bbs.huochengrm.cn/questions/4320.html","normalizedUrl":"https://bbs.huochengrm.cn/questions/4320.html","domain":"bbs.huochengrm.cn","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"获取账户下素材列表","url":"https://open.oceanengine.com/labels/12/docs/1810701753348235","normalizedUrl":"https://open.oceanengine.com/labels/12/docs/1810701753348235","domain":"open.oceanengine.com","validUrl":true,"contentStatus":"页面内容未核验"}]},{"id":"CMCR-S-20260819-C2-Q0025","q":"CMCR-Q0025","question":"千川隐藏素材在哪里看？","day":2,"repeat":2,"valid":true,"answer":"“千川隐藏素材”通常分两种场景（**自己账号的隐藏素材** vs **竞品的隐藏投放素材**），查看方式完全不同，具体如下：\n\n### 一、查看自己账号的“隐藏素材”\n这里的“隐藏”一般指**未在抖音主页公开、仅用于千川投放的本地上传素材**，或被筛选/归档的素材，直接在千川后台即可查看：\n1. **核心入口：素材管理/视频库**\n   登录巨量千川PC后台，点击左侧菜单栏「工具」-「创意管理」-「视频库」（或直接找「素材管理」入口），这里会展示你账户下**所有上传过的素材**（包括本地上传、未同步抖音主页的“隐藏”投放素材）。\n   - 可通过「视频来源」筛选：选择「本地上传」，即可看到所有没在抖音主页发布、仅用于千川投放的“隐藏素材”；\n   - 也可按素材状态、上传时间、素材名称/ID搜索，快速定位目标素材。\n2. **其他辅助入口**\n   - 创编计划时：在「添加视频」-「我的视频」里，也能看到全部账户素材（含隐藏投放素材）；\n   - 素材分析页：进入「数据」-「素材分析」-「视频素材」，可查看所有素材的投放数据（即使是未公开的投放素材也会统计）。\n\n### 二、查看竞品的“千川隐藏素材”\n竞品的高转化素材往往不会公开在抖音主页，而是直接通过千川后台投放（即“隐藏素材”），官方后台无法直接查看，需借助第三方数据工具：\n以**蝉妈妈**为例（主流千川竞品分析工具）：\n1. 进入蝉妈妈后台，打开「创意」-「找素材」页面；\n2. 使用「素材定向追踪」功能，输入竞品的抖音号、小店名称或品牌关键词，系统可在30分钟内捕获同行新投的隐藏素材（含直播引流素材、商品广告素材、CID广告素材等）；\n3. 还可通过「品类」「素材形式」「完播率」「跑量条件」精细化筛选，重点看「跑量素材榜」「高增量素材榜」，快速锁定竞品近期起量的隐藏投放素材。\n同类工具还有巨量创意的创意洞察、飞瓜数据等，核心逻辑都是通过抓取全网千川投放数据，还原未公开的隐藏素材。","answerHash":"7db0d43a4dfcec26b8a1b060cba3baf629eb12b92b85b2efaf50565d79a522e7","finishedAt":"2026-08-19","replacement":false,"brands":["蝉妈妈"],"sources":[{"title":"竞品千川素材怎么查？蝉妈妈监控投放策略 原创","url":"https://blog.csdn.net/chanmama8888/article/details/163539515","normalizedUrl":"https://blog.csdn.net/chanmama8888/article/details/163539515","domain":"blog.csdn.net","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"竞品千川素材怎么查？蝉妈妈监控投放策略 原创","url":"https://blog.csdn.net/chanmama8888/article/details/163539515","normalizedUrl":"https://blog.csdn.net/chanmama8888/article/details/163539515","domain":"blog.csdn.net","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"如何查看千川素材？","url":"https://bbs.huochengrm.cn/questions/4320.html","normalizedUrl":"https://bbs.huochengrm.cn/questions/4320.html","domain":"bbs.huochengrm.cn","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"如何查看千川素材？","url":"https://bbs.huochengrm.cn/questions/4320.html","normalizedUrl":"https://bbs.huochengrm.cn/questions/4320.html","domain":"bbs.huochengrm.cn","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"如何查看千川素材？","url":"https://bbs.huochengrm.cn/questions/4320.html","normalizedUrl":"https://bbs.huochengrm.cn/questions/4320.html","domain":"bbs.huochengrm.cn","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"【巨量千川】千川素材要在主页隐藏吗？1分钟让你看懂隐藏素材的影响","url":"https://www.bilibili.com/video/BV1kt421h7P4/","normalizedUrl":"https://www.bilibili.com/video/BV1kt421h7P4/","domain":"www.bilibili.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"抖音千川投流避坑指南，高效推广短视频的秘诀","url":"https://www.jiajutu.com/jiaocheng/046047.html","normalizedUrl":"https://www.jiajutu.com/jiaocheng/046047.html","domain":"www.jiajutu.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"【巨量千川】短视频带货场景优质素材产品功能使用指南","url":"https://cc.oceanengine.com/academy/article-detail/10338","normalizedUrl":"https://cc.oceanengine.com/academy/article-detail/10338","domain":"cc.oceanengine.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"获取账户下素材列表","url":"https://open.oceanengine.com/labels/12/docs/1810701753348235","normalizedUrl":"https://open.oceanengine.com/labels/12/docs/1810701753348235","domain":"open.oceanengine.com","validUrl":true,"contentStatus":"页面内容未核验"}]},{"id":"CMCR-S-20260819-C3-Q0025","q":"CMCR-Q0025","question":"千川隐藏素材在哪里看？","day":2,"repeat":3,"valid":true,"answer":"# 千川隐藏素材查看\n> 千川里常说的**隐藏素材 = 本地上传千川、不发布到抖音主页的广告视频**，抖音主页看不到，但用于千川投放。\n\n## ✅ 看自己账户的隐藏素材（官方千川后台）\nPC千川后台：**工具 → 创意管理 → 视频库**\n这里可以看到本账户所有本地上传的视频（就是主页不展示的隐藏投放素材），不分是否正在投放，只要没删除都在这里，支持预览、下载、复用。\n\n补充：\n1. 素材分析页面（数据→素材分析），也能看到本账户全部投放过的素材，包含本地上传素材。\n2. 千川官方**没有一个叫“隐藏素材”独立筛选按钮**；本地上传素材和主页发布素材在视频库里按来源区分。\n\n## ❗看竞品/别人的千川隐藏素材\n**巨量千川官方后台，不能直接查看别人账户的本地上传隐藏素材**，这属于其他广告主私有广告物料，官方不开放查看。\n市面上蝉妈妈、考古加等第三方工具，可以通过广告抓取看到部分公开投放过的竞品隐藏素材，属于第三方付费能力，非千川官方功能。\n\n## 容易混淆的另外2种“隐藏”\n1. **抖音主页视频设置【主页不展示】（hide_in_aweme）**：视频原本是主页作品，投放千川时设置不在主页展示。\n- 自己账号：视频库、素材分析可以看到这条素材；抖音主页看不到该作品。\n2. **被系统判定低质/拒审素材**：不是“隐藏素材”，筛选路径：工具‑视频库，筛选「素材建议‑低质素材」查看。\n\n## 找不到素材怎么办\n1. 确认没有在视频库手动删除；删除之后无法恢复。\n2. 创编计划页只展示部分素材，点「前往素材库」跳转完整视频库。\n3. 有疑问，PC千川右下角智投星联系千川官方客服。\n\n> 提示：不要直接搬运抓取到的竞品素材，会触发搬运违规处罚。\n\n如果你需要，我可以给你整理一份视频库快速定位本地上传素材的操作要点。","answerHash":"a18212640d48cfdbf2fd9a89ade1b0b1d9d1d23f9f29dbe1522fe7d1a82c7b1b","finishedAt":"2026-08-19","replacement":false,"brands":["蝉妈妈"],"sources":[{"title":"如何看千川隐藏素材? - 自媒体问答 - HCRM问答","url":"https://bbs.huochengrm.cn/questions/21098.html","normalizedUrl":"https://bbs.huochengrm.cn/questions/21098.html","domain":"bbs.huochengrm.cn","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"怎么查看千川隐藏素材。左侧导航栏点击 搜竞对 / 盯竞对 输入竞品抖音号、店铺名、达人昵称搜索，添加监控 进入竞品详情页，切换标签：千川投放素材 蝉妈妈创意会员有需要的可以私聊  ","url":"https://www.iesdouyin.com/share/video/7658224428979875066","normalizedUrl":"https://www.iesdouyin.com/share/video/7658224428979875066","domain":"www.iesdouyin.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"蝉妈妈创意工具查看千川隐藏视频方法","url":"https://www.iesdouyin.com/share/video/7595133389545524901","normalizedUrl":"https://www.iesdouyin.com/share/video/7595133389545524901","domain":"www.iesdouyin.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"蝉妈妈创意工具助力电商竞争对手隐藏素材获取策略","url":"https://www.iesdouyin.com/share/video/7544311342484819240","normalizedUrl":"https://www.iesdouyin.com/share/video/7544311342484819240","domain":"www.iesdouyin.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"抖音电商学习中心","url":"https://school.jinritemai.com/doudian/wap/course-series/cJZHjLnhaLyw/cJZHjLnhaLywlJZJUawr8APt?should_hide_bottom_nav=1&from_school=1&should_full_screen=1&from=href","normalizedUrl":"https://school.jinritemai.com/doudian/wap/course-series/cJZHjLnhaLyw/cJZHjLnhaLywlJZJUawr8APt?should_hide_bottom_nav=1&from_school=1&should_full_screen=1&from=href","domain":"school.jinritemai.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"抖音巨量千川平台更新低质量内容治理策略 - 多面手企业网络推广一站式服务","url":"https://www.80tg.com/news/43430.html","normalizedUrl":"https://www.80tg.com/news/43430.html","domain":"www.80tg.com","validUrl":true,"contentStatus":"页面内容未核验"},{"title":"如何看千川隐藏素材? - 自媒体问答 - HCRM问答","url":"https://bbs.huochengrm.cn/questions/21098.html","normalizedUrl":"https://bbs