{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "creative-dashboard-data.schema.json",
  "title": "Creative GEO sampling dashboard data",
  "type": "object",
  "required": ["schemaVersion", "dashboardVersion", "status", "final", "runId", "route", "summary", "metricGroups", "competition", "diagnostics", "traceability", "samples"],
  "properties": {
    "schemaVersion": {"const": 2},
    "dashboardVersion": {"const": "CMCR_CREATIVE_SAMPLING_DASHBOARD_20260819_R4"},
    "status": {"const": "FINAL_FROZEN_PARTIAL_WITH_RECOVERABLE_UNKNOWNS"},
    "final": {"const": true},
    "runId": {"const": "cmcr-20260818-recapture-20260819-r1"},
    "route": {"const": "/chanmama-creative-geo/"},
    "summary": {
      "type": "object",
      "required": ["sampleCount", "formalAnswerCount", "recoverableUnknown", "recoverySubmitted", "recoveryFormalAnswers", "totalExternalSubmissions", "pointsConsumed", "pendingSampleId"],
      "properties": {
        "sampleCount": {"const": 270},
        "formalAnswerCount": {"const": 269},
        "recoverableUnknown": {"const": 1},
        "recoverySubmitted": {"const": 8},
        "recoveryFormalAnswers": {"const": 7},
        "totalExternalSubmissions": {"const": 278},
        "pointsConsumed": {"const": 222.4},
        "pendingSampleId": {"const": "CMCR-CMP-20260819-C2-Q0087"}
      },
      "additionalProperties": false
    },
    "metricGroups": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "label", "description", "metrics"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "description": {"type": "string"},
          "metrics": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "label", "numerator", "denominator", "percentage", "unknown", "scope"],
              "properties": {
                "id": {"type": "string", "not": {"const": "citation_rate"}},
                "label": {"type": "string"},
                "numerator": {"type": "number"},
                "denominator": {"type": "number"},
                "percentage": {"type": "number"},
                "unknown": {"type": "number"},
                "scope": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "competition": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["brand", "mentions", "share"], "properties": {"brand": {"type": "string"}, "mentions": {"type": "integer"}, "share": {"type": "number"}}, "additionalProperties": false}},
    "diagnostics": {"type": "object"},
    "traceability": {"type": "object", "required": ["rawManifestSha256", "metricsSha256", "semanticAuditSha256", "sampleDetailsSha256", "validationSha256", "auditRows", "detailRows"], "properties": {"rawManifestSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "metricsSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "semanticAuditSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "sampleDetailsSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "validationSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}, "auditRows": {"const": 510}, "detailRows": {"const": 270}}, "additionalProperties": false},
    "samples": {
      "type": "array",
      "minItems": 270,
      "maxItems": 270,
      "items": {
        "type": "object",
        "required": ["sampleId", "questionId", "question", "pool", "category", "round", "status", "brands", "featureGroups", "auditDecisions", "answerExcerpt"],
        "properties": {
          "sampleId": {"type": "string"},
          "questionId": {"type": "string"},
          "question": {"type": "string"},
          "pool": {"type": "string"},
          "category": {"type": "string"},
          "round": {"type": "string"},
          "status": {"enum": ["formal", "recoverable_unknown"]},
          "brands": {"type": "array", "items": {"type": "string"}},
          "featureGroups": {"type": "array", "items": {"type": "string"}},
          "auditDecisions": {"type": "array", "items": {"type": "object", "required": ["metricId", "decision"], "properties": {"metricId": {"type": "string"}, "decision": {"type": "string"}}, "additionalProperties": false}},
          "answerExcerpt": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
