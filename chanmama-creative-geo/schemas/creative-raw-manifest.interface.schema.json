{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "creative-raw-manifest.interface.schema.json",
  "title": "Creative GEO frozen raw manifest interface",
  "type": "object",
  "required": [
    "schemaVersion",
    "status",
    "run_id",
    "question_source_hash",
    "executionSurface",
    "entryAuthority",
    "raw_root",
    "sample_count",
    "samples"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "status": {"enum": ["FROZEN", "INCREMENTAL"]},
    "non_final": {"type": "boolean"},
    "run_id": {"type": "string", "minLength": 1},
    "question_source_hash": {
      "const": "553C387B149AC60AAA644F1D7030C8A3D21460273A78B7A7EA354C7EC8648131"
    },
    "executionSurface": {"const": "AIDSO"},
    "entryAuthority": {"const": "https://www.aidso.com/"},
    "raw_root": {"type": "string", "minLength": 1},
    "sample_count": {"type": "integer", "minimum": 1},
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sample_id",
          "question_id",
          "question_signature",
          "platform_id",
          "terminal",
          "raw_status",
          "raw_record_path",
          "raw_record_sha256"
        ],
        "properties": {
          "sample_id": {"type": "string", "minLength": 1},
          "question_id": {"type": "string", "pattern": "^CMCR-Q[0-9]{4}$"},
          "question_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "platform_id": {"type": "string", "minLength": 1},
          "terminal": {"type": "string", "minLength": 1},
          "raw_status": {"const": "collected"},
          "raw_record_path": {"type": "string", "minLength": 1},
          "raw_record_sha256": {"type": "string", "pattern": "^[0-9A-F]{64}$"}
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "INCREMENTAL"}}},
      "then": {
        "required": ["non_final"],
        "properties": {"non_final": {"const": true}}
      }
    }
  ],
  "additionalProperties": true,
  "x-final-status": "FROZEN"
}
